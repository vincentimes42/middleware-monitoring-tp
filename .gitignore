# ------------------------------------------------------------------
#  TP Monitoring / Observability — .gitignore
# ------------------------------------------------------------------

# The app's log file now lives on the shared `middleware-logs` volume,
# not in this tree — nothing to ignore for logs anymore.

# Local data / secrets / editors
*.log
*.env
.env
.env.*
*.local
*.sqlite
*.db

# IDE
.idea/
.vscode/
*.iml

# Ad-hoc scratch / shell-redirect output (e.g. `docker compose ... 2> err.txt`)
/err*.txt
/out*.txt

# OS
.DS_Store
