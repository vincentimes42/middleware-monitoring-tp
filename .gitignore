# ------------------------------------------------------------------
#  TP Monitoring / Observability — .gitignore
# ------------------------------------------------------------------

# The app's log file lives on the shared `middleware-logs` volume; the local
# `logs/` folder is only a placeholder kept by `.gitkeep`.
logs/*
!logs/.gitkeep

# --- Secrets and local env (the Gemini key lives in the shell only) ---
.env
.env.*
*.env
*.local

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
.factorypath

# --- Logs and ad-hoc shell-redirect output (e.g. `... 2> err.txt`) ---
*.log
/err*.txt
/out*.txt

# --- OS ---
.DS_Store
Thumbs.db
